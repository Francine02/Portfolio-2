{
  "compilerOptions": {
    "target": "es6",
    "jsx": "react",
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@constants/*": ["constants/*"],
      "@assets/*": ["assets/*"],
      "@i18n/*": ["i18n/*"],
      "@lib/*": ["lib/*"],
      "@projects/*": ["projects/*"]
    }
  },
  "include": ["src"]
}
